# RakshaRakt environment variables - copy to .env.local and fill in real values.
# Shared infra - every feature reads these; see lib/supabase.ts and lib/gemini.ts.
#
# !! NEVER commit the filled-in .env.local !!
# .gitignore already ignores it, but `git add -f` / `git mv` will still track it
# - this exact mistake leaked real Supabase keys into git history TWICE already.
# Always check `git status` before committing. If real keys ever land in git
# history, rotate them immediately in the Supabase dashboard (Settings -> API
# Keys) - deleting the file from a later commit does NOT purge git history.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key

# Demo tuning knobs (safe defaults shown). Lower these during a live demo so
# escalation / ghosting are visible within seconds instead of minutes.
DEMO_ESCALATION_SECONDS=300
GHOST_WINDOW_MIN=10
AVG_SPEED_KMH=25
ETA_BUFFER_MIN=2
