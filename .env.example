# RakshaRakt – Environment Variables
# Copy this file to .env.local and fill in real values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI (leave blank to use deterministic fallback – demo still works)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Business logic tuning (demo-friendly overrides)
# How many seconds before radius auto-escalates (default 300 = 5 min; set to 30 for demo)
DEMO_ESCALATION_SECONDS=30

# How many minutes before a non-moving en_route donor is marked as ghost
GHOST_WINDOW_MIN=2

# Average urban travel speed for ETA calculation (km/h)
NEXT_PUBLIC_AVG_SPEED_KMH=25
